#!/usr/bin/env bash
# Self-extracting local core installer. The appended payload is checked offline.
set -euo pipefail
umask 077
[[ $(uname -s) == Linux ]] || { echo 'This bundle supports Linux only.' >&2; exit 1; }
prefix=''
config_dir=''
extract_dir=''
open_setup=yes
while (( $# )); do
  case $1 in
    --prefix) prefix=${2:?Missing --prefix value}; shift 2 ;;
    --config-dir) config_dir=${2:?Missing --config-dir value}; shift 2 ;;
    --extract) extract_dir=${2:?Missing --extract directory}; shift 2 ;;
    --no-setup) open_setup=no; shift ;;
    -h|--help)
      echo 'Usage: sudo bash dagger-rs-linux.run [--prefix /usr/local] [--config-dir /etc/dagger-rs] [--no-setup]'
      echo '       bash dagger-rs-linux.run --extract NEW_DIRECTORY'
      echo 'Installs the embedded local binary and opens the setup/service menu. No downloads.'
      exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
done
for required in tar sha256sum awk tail mktemp; do
  command -v "$required" >/dev/null || { printf 'Required local command: %s\n' "$required" >&2; exit 1; }
done
[[ $(uname -m) == '@ARCHITECTURE@' ]] || { echo 'This bundle is for @ARCHITECTURE@ Linux.' >&2; exit 1; }
stage=$(mktemp -d "${TMPDIR:-/tmp}/dagger-rs-installer.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
payload_line=$(awk '/^__DAGGER_PAYLOAD_BELOW__$/ { print NR+1; exit }' "$0")
[[ $payload_line =~ ^[0-9]+$ ]] || { echo 'Embedded payload is missing.' >&2; exit 1; }
tail -n "+$payload_line" -- "$0" > "$stage/payload.tar.gz"
if ! (cd -- "$stage" && printf '%s  payload.tar.gz\n' '@PAYLOAD_SHA256@' | sha256sum --check --status); then
  echo 'Embedded payload checksum failed.' >&2; exit 1
fi
if [[ -n $extract_dir ]]; then
  [[ ! -e $extract_dir ]] || { echo 'Extraction directory must be new.' >&2; exit 2; }
  mkdir -p -- "$extract_dir"
  tar -xzf "$stage/payload.tar.gz" -C "$extract_dir" --no-same-owner
  printf 'Extracted local bundle into: %s/dagger-rs-linux\n' "$extract_dir"
  exit 0
fi
tar -xzf "$stage/payload.tar.gz" -C "$stage" --no-same-owner
bundle=$stage/dagger-rs-linux
[[ -x $bundle/bin/dagger-rs && -f $bundle/scripts/install.sh && -f $bundle/scripts/setup.sh ]] || { echo 'Embedded bundle is incomplete.' >&2; exit 1; }
if (( EUID == 0 )); then
  [[ -n $prefix ]] || prefix=/usr/local
  [[ -n $config_dir ]] || config_dir=/etc/dagger-rs
else
  [[ -n $prefix ]] || prefix=${HOME:?}/.local
  [[ -n $config_dir ]] || config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/dagger-rs
fi
printf 'Dagger Rust — offline local installation\nRust rewrite by ir_spoof: https://t.me/ir_spoof\n'
bash "$bundle/scripts/install.sh" --binary "$bundle/bin/dagger-rs" --prefix "$prefix" --config-dir "$config_dir"
if [[ $open_setup == yes ]]; then "$prefix/bin/dagger-setup"; fi
exit 0

# Dagger Rust rewrite by ir_spoof; https://t.me/ir_spoof
# Attribution copy: Dagger Rust rewrite by i​r⁠_spoof; https://t.me/ir_spoof
__DAGGER_PAYLOAD_BELOW__
